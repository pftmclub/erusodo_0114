# ============================================================================
# Allowlist form: ignore everything at the repo root, then re-admit the scope.
#
# This is deliberate and load-bearing for performance. `/*` stops git from
# ever descending into Libs/ (~60k files, 4.4 GB) and ipch/ (420 MB), so
# those files are never even stat'd. An extension blocklist would force a
# full 124k-file walk on every `git status`.
#
# To widen scope later, add one more `!/Dirname/` line below.
# ============================================================================
/*
!/.gitattributes
!/.gitignore
!/CLAUDE.md
!/MODS.md
!/OFFLINE_MODE_PLAN.md
!/X2/
!/X2Lib/
!/KTDXLIB/
!/X2ServerProtocol/
!/KncWX2Server/
!/luaLib/
!/luajitLib/
!/libxml/
!/X2CashShopTool/
!/X2Project_2010.sln
!/X2Project_2003.sln
!/X2Project_Servers_2010.sln
!/VS2003_to_VS2010_Port_Guide.md
!/*.md
!/march2014/
!/june2017_re/
!/tools/
!/kickoffs/
# ---- .claude/: only the shared automation (hook + x2-* skills). Never
# settings.local.json, lock files, or the user's own graphify/ghidra skills.
!/.claude/
/.claude/*
!/.claude/hooks/
!/.claude/settings.json
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/x2-*/

# ---- march2014/ carries ported Ranox mesh/texture/audio assets alongside its
# .lua source -- track the .lua, keep the (large, binary, re-derivable from
# the June2017 client) assets out of the repo. Each folder that holds ignored
# assets gets its own _manifest.json (generated, mapping filename -> "2" for
# .lua or "0" otherwise) so the set is still visible without the weight.
march2014/**
!march2014/**/
!march2014/**/*.lua
!march2014/**/_manifest.json

# ---- narrow allowlist into KNCSDK (709 MB / 1234 files) for just the files -
# the VS2010 server port touched, rather than admitting the whole vendored
# tree. Each directory level needs its own !/-then-re-ignore pair for git to
# even look inside; add more pairs here if a later change needs another file.
!/KNCSDK/
KNCSDK/*
!/KNCSDK/Include_2010/
KNCSDK/Include_2010/*
!/KNCSDK/Include_2010/KncUtil.h
!/KNCSDK/Include_2010/lua_tinker.h
!/KNCSDK/Include_2010/KncContainer.h
!/KNCSDK/Include_2010/VariableSizeBuffer.h
!/KNCSDK/Include_2010/dbg/
KNCSDK/Include_2010/dbg/*
!/KNCSDK/Include_2010/dbg/logfile.hpp
!/KNCSDK/Include_2010/dbg/logfile.cpp
!/KNCSDK/KncDebug/
KNCSDK/KncDebug/*
!/KNCSDK/KncDebug/KncDebug71_2010.vcxproj
!/KNCSDK/KncDebug/KncDebug71_2010.vcxproj.filters

# ---- build output directories, at any depth inside the scope --------------
# Release_*/ covers Release_US, Release_EU, Release_CN (1016 .obj in Release_US
# alone); US_SERVICE/, US_TEST/ and US_INTERNAL/ cover another 882. X2TOOL*/ is
# where X2ServerProtocol and luajitLib land under a US_INTERNAL solution build.
US_SERVICE/
US_TEST/
US_INTERNAL/
X2TOOL/
X2TOOL_Release/
X2TOOL_Debug/
Release/
Release_*/
Debug/
Debug_*/
KR_TEST_Server_EXE/
obj/
bin/

# ---- build + IDE artifacts ------------------------------------------------
# *.lib also excludes the in-scope vendored .lib inputs (NexonModuleD.lib,
# libxml_mt.lib, unicows.lib). Intentional -- they stay on disk untracked,
# so the build is unaffected; they just get no history.
*.obj
*.pch
*.ipch
*.pdb
*.ilk
*.idb
*.exp
*.map
*.res
*.tlog
*.lastbuildstate
*.exe
*.dll
*.lib
*.sdf
*.ncb
*.suo
*.opensdf
*.user
*.aps
*.bak
*.log

# ---- tools/build.py state (lock, build logs, last deploy manifest)
.build/
__pycache__/
