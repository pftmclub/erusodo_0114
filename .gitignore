# ============================================================================
# Blocklist form: everything is tracked unless it is listed here.
#
# History: this file used to be an allowlist (`/*` then `!/Dir/` per project),
# which left most of the real project (tools, SDK headers, content tools,
# ScriptData, DataBase, ...) silently untracked. It is now the reverse. A new
# top-level directory is tracked by default; if it should not be, add it to
# section 1 or 2 below.
#
# Performance: directories that are ignored by a "dir/" rule are never walked,
# so keep the huge ones (Libs/, tmp/, DB_Backup/) as explicit directory rules.
# ============================================================================

# ---- 1. Third-party libraries: NOT in the repo (see README.md, "Libraries") --
/Libs/

# ---- 2. Scratch, caches and derived data (regenerable, or not project) ------
# Session scratch and tool state
/tmp/
/.build/
/ipch/
/.vs/
/.sock_*.tmp
/--help
/-h
/notes.txt
# Machine-specific: absolute paths to the user's Ghidra install
/.mcp.json
# Local database dumps / backups (also confidential)
/DB_Backup/
# Decompiled June client Lua: 7,300 files / 220 MB, regenerate with
# june2017_re/ljd_jun2017.py from the June kom archives
/june_src_fixed/
# Ghidra / decompiler dumps and caches under june2017_re (see its own .gitignore)
/june2017_re/pp/
/june2017_re/assets_cache/

# ---- 3. .claude/: only the shared automation (hook, settings, x2-* skills) --
# Never settings.local.json, lock files, or the user's own graphify/ghidra
# skills.
/.claude/*
!/.claude/hooks/
!/.claude/settings.json
!/.claude/CLAUDE.md
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/x2-*/
!/.claude/skills/elstools/
/.claude/*.lock
/.claude/*.graphify-bak

# ---- 4. march2014/: track the .lua source, not the binary game assets ------
# march2014 holds ported Ranox mesh/texture/audio assets (ogg, x, tga, dds,
# avi, ...) next to its .lua. Those are large (~380 MB), binary and
# re-derivable from the June 2017 client, so only the .lua and each folder's
# generated _manifest.json (filename -> "2" for .lua, "0" otherwise) are kept.
/march2014/**
!/march2014/**/
!/march2014/**/*.lua
!/march2014/**/_manifest.json

# ---- 5. Build output directories, at any depth ------------------------------
# Release_*/ = Release_US/EU/CN/...; US_SERVICE/, US_TEST/, US_INTERNAL/ and the
# other region configs are per-config output dirs. X2TOOL*/ is where
# X2ServerProtocol and luajitLib land.
US_SERVICE/
US_TEST/
US_INTERNAL/
X2TOOL/
X2TOOL_Release/
X2TOOL_Debug/
Release/
Release_*/
Debug/
Debug_*/
INT_TEST/
KR_TEST_Server_EXE/
obj/
bin/
x64/
ipch/

# ---- 6. Compiler / linker / IDE artifacts -----------------------------------
*.obj
*.o
*.pch
*.ipch
*.pdb
*.ilk
*.idb
*.exp
*.map
*.res
*.sbr
*.bsc
*.tlog
*.lastbuildstate
*.unsuccessfulbuild
*.cache
*.i
*.sdf
*.ncb
*.suo
*.opensdf
*.user
*.aps
*.VC.db
*.VC.opendb
*.log
*.tmp
*.bak
BuildLog.htm
Thumbs.db
desktop.ini

# Prebuilt binaries. Rebuilt from source, or provided by the library set listed
# in README.md. (The in-house tools that need a binary, e.g. elstools.exe, are
# re-admitted explicitly at the bottom.)
*.exe
*.dll
*.lib
*.a
*.zip
*.gz

# ---- 7. Version-control leftovers, Python, local tool state ------------------
.svn/
_svn/
CVS/
__pycache__/
*.pyc
# elstools: config holds absolute paths of this machine; err1.txt and
# AccountQuest.lua are stray command output
/elstools/elstools_config.json
/elstools/err1.txt
/elstools/AccountQuest.lua

# ---- 8. Re-admitted binaries the workflow cannot run without ---------------
# (must stay below the *.exe rule above)
!/elstools/elstools.exe
